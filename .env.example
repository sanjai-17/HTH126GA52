# Local AI / Open-Source LLM Provider (Ollama)
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"

# Demo Mode fallback (set to true when running without local Ollama daemon)
DEMO_MODE="false"

# GitHub Token (Optional for public repositories, increases rate limit)
GITHUB_TOKEN="ghp_UqM1Qs9pcb2k4FVfi7isRmgpI08pbx25Wzcm"

# GitHub PR Commenting (Disabled by default for safety)
ENABLE_GITHUB_COMMENTS="false"

# Risk Thresholds (Application-defined thresholds: 0-20 Low, 21-40 Moderate, 41-60 Elevated, 61-80 High, 81-100 Critical)
RISK_THRESHOLD_HIGH="60"
RISK_THRESHOLD_CRITICAL="80"

# Optional Cloud API keys (kept only for backward compatibility; zero paid API required)
GEMINI_API_KEY=""
APP_URL="MY_APP_URL"
